{
  "name": "revenue-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for Revenue AI Dashboard - Revenue forecasting, inventory management and sales analytics",
  "author": "Revenue AI Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "cross-env NODE_ENV=development nest start",
    "dev": "cross-env NODE_ENV=development nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "db:init": "npx ts-node scripts/init-db.ts",
    "db:setup": "npm run db:init && npm run data:all",
    "data:all": "npx ts-node --require tsconfig-paths/register scripts/import-data.ts all",
    "check-data": "npx ts-node scripts/check-data.ts"
  },
  "scriptsDescription": {
    "build": "Biên dịch TypeScript sang JavaScript",
    "start": "Chạy server",
    "dev": "Chạy ở chế độ phát triển (HMR)",
    "start:debug": "Chạy server ở chế debug (watch)",
    "start:prod": "Chạy server ở chế độ production",
    "format": "Định dạng code bằng Prettier",
    "lint": "Kiểm tra & tự động sửa lỗi ESLint",
    "db:init": "Khởi tạo database & tables từ database/init.sql",
    "db:setup": "Khởi tạo DB + import toàn bộ dữ liệu (1 lệnh duy nhất)",
    "data:products": "Import dữ liệu sản phẩm từ Excel",
    "data:sales": "Import dữ liệu bán hàng từ Excel",
    "data:inventory": "Import dữ liệu tồn kho từ Excel",
    "data:all": "Import toàn bộ dữ liệu (products + sales + inventory)",
    "check-data": "Kiểm tra dữ liệu trong database",
    "migration:generate": "Tạo migration mới từ entity",
    "migration:run": "Chạy migration",
    "migration:revert": "Rollback migration",
    "migration:create": "Tạo file migration trống"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^3.4.0",
    "mysql2": "^3.22.3",
    "nest-winston": "^1.10.2",
    "openai": "^6.45.0",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.24",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "run-script-webpack-plugin": "^0.2.3",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.106.2",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "multer": "^2.1.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}